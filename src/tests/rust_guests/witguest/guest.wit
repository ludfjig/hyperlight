/// Hyperlight WIT Demo - showcases bidirectional host-guest communication
package hyperlight:greeting-demo;

world greeting-demo {
  import time-service;
  export greeting;
}

/// Host-provided time services
interface time-service {
  /// Get the current time as a formatted string
  get-current-time: func() -> string;
}

/// Guest-provided greeting functionality
interface greeting {
  /// Create a personalized greeting with current time from host
  greet-user: func(username: string) -> string;
}